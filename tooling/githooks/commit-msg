#!/bin/sh
# commit-msg — keep private project names out of this public repo's history.
#
# The gate scans the working TREE. A commit message is never in the tree, so it
# was never checked, and it is the one artefact that cannot be fixed later:
# redaction is not removal, and a history rewrite is a separate, deliberate
# decision that has already been made the other way.
#
# Measured on this repo before writing this hook:
#
#   304 commits · 19 message lines carrying a private project name
#
# Every one is a true positive — this repo is public, so a private codebase's
# name in its history is exactly the thing the tree-level gate exists to stop.
# Precision on that corpus is 100%, which is why this is a hard block and not a
# warning.
#
# Five of those 19 lines are from commit 8b57919, written the same day the
# write-time hook shipped: a before/after table naming three private repos. The
# tree gate caught the identical table in the source file and it was anonymised;
# the copy in the commit message went through unchecked and was pushed. Nothing
# was checking it. Now something is.
#
# WHY THIS DELEGATES INSTEAD OF GREPPING.
#
# It used to read the denylist out of the checker with sed and build a regex.
# That stopped being possible on 2026-08-22, when the list became DIGESTS rather
# than names — there is no longer a plaintext list to read, which is the whole
# point. Matching now needs the checker's own normalise-and-hash, so the hook
# calls the checker instead of reimplementing it in shell. One implementation,
# no drift, and the shell never has to hold a name.
#
# Enable (not automatic on clone):
#   git config core.hooksPath tooling/githooks
#
# Bypass, when you mean it:  git commit --no-verify

MSG_FILE="$1"
ROOT="$(git rev-parse --show-toplevel)"
CHECKER="$ROOT/tooling/check-no-private-names.js"
CLAIMS="$ROOT/tooling/check-claim-provenance.js"

# Inert where there is no gate to delegate to - this hook is installed per-clone
# via core.hooksPath and must not break another repo.
[ -f "$CHECKER" ] || exit 0

# --- claim provenance: WARN, never block ------------------------------------
#
# Second gate on the same message, added after a day that produced five
# confident wrong claims, every one caught by a human or a second probe rather
# than by anything here. An absence or completeness claim ("exactly N", "no X
# found", "84 of 85") must say where it came from: a [measured]/[reported]/
# [stated]/[inferred] tag, or a backticked command a reader can re-run.
#
# It warns rather than blocks, deliberately. The private-name gate below blocks
# because its precision on this repo's history is 100% and the damage is
# unfixable. This one is new, its precision on real history is not established,
# and a noisy blocker gets bypassed with --no-verify until it is ignored
# entirely. It earns a block when the numbers justify one.
#
# It runs FIRST so its warning is visible whether or not the blocking gate
# fires below.
if [ -f "$CLAIMS" ]; then
    CLAIM_HITS=$(node "$CLAIMS" --check-message "$MSG_FILE" 2>&1)
    if [ $? -eq 1 ]; then
        echo ""
        echo "commit-msg WARNING: unlabelled absence/completeness claim(s)."
        echo ""
        echo "$CLAIM_HITS"
        echo ""
        echo "Add [measured: <command>], [reported], [stated] or [inferred],"
        echo "or name the command in backticks. Not blocking; the commit proceeds."
    fi
fi

# --check-message ignores '#' lines (git's template comments never reach the
# message) and prints "  <line-no>: <line>" for every hit. Exit 1 means a hit,
# exit 2 means the hook was called wrong - neither is a reason to pass.
HITS=$(node "$CHECKER" --check-message "$MSG_FILE" 2>&1)
STATUS=$?

[ "$STATUS" -eq 0 ] && exit 0

echo ""
if [ "$STATUS" -eq 1 ]; then
    echo "commit-msg: this message names a private project, and this repo is PUBLIC."
    echo ""
    echo "$HITS"
    echo ""
    echo "A commit message cannot be fixed after the fact the way a file can -"
    echo "redaction is not removal. Anonymise now (Project A/B/C, keeping the"
    echo "numbers and the product shape)."
else
    # An unrecognised failure is the DANGEROUS case, not the safe one: a checker
    # that cannot run has not cleared anything. Refuse rather than pass.
    echo "commit-msg: the private-name checker could not run, so nothing was checked."
    echo ""
    echo "$HITS"
    echo ""
    echo "This repo is PUBLIC. A check that did not run is not a check that passed."
fi
echo ""
echo "Deliberate exception: git commit --no-verify"
exit 1
