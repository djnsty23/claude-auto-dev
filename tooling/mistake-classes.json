    "verification-traps-index.md"
  ],
  "classes": [
    {
      "id": "probe-too-early",
      "name": "A probe reads the right surface before it settled",
      "definition": "A wait, poll or screenshot reads a surface that has not stopped changing, so it measures a moment, not a state.",
      "match": [
        "too early",
        "stopped changing",
        "polling",
        "waiting on a condition",
        "streamed content",
        "one-shot wait",
        "watcher that only",
        "hijacks the view"
      ],
      "anchors": [
        {
          "kind": "rule",
          "repo": "mirror",
          "path": "skills/lessons/references/agent-quality-full.md",
          "re": "too early"
        },
        {
          "kind": "rule",
          "repo": "mirror",
          "path": "rules/agent-quality.md",
          "re": "10l|too early|stopped changing"
        },
        {
          "kind": "rule",
          "repo": "mirror",
          "path": "rules/verification-traps.md",
          "re": "too early|stopped changing|poll"
        }
      ],
      "mineFixes": [
        "ordering / async race"
      ]
    },
    {
