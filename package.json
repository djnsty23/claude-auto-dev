    "check:queue": "node plugins/autodev-core/scripts/check-queue-drained.js --selftest",
    "check:triggers": "node tooling/check-skill-triggers.js",
    "check:runtime": "node tooling/check-runtime.js",
    "actions:cost": "node tooling/analyze-actions-cost.js",
    "check:agent-budget": "node tooling/agent-budget.js"
