{
  "name": "claude-auto-dev",
  "version": "8.92.0",
  "description": "Autonomous development workflow for Claude Code, distributed as a plugin marketplace",
  "private": true,
  "keywords": [
    "claude",
    "claude-code",
    "claude-code-plugin",
    "ai",
    "autonomous",
    "development",
    "task-management",
    "claude-skills"
  ],
  "scripts": {
    "test": "node tooling/test-all.js",
    "validate": "node tooling/validate.js",
    "bump": "node tooling/bump.js",
    "check:suites": "node tooling/check-suites-can-fail.js",
    "check:vacuity": "node tooling/find-vacuous-assertions.js",
    "check:hooks": "node tooling/find-untested-hooks.js",
    "check:versions": "node tooling/check-version-drift.js",
    "check:functions": "node tooling/find-untested-functions.js",
    "check:superseded": "node tooling/check-superseded.js",
    "check:agent-cost": "node tooling/analyze-agent-cost.js",
